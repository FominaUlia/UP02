<Window x:Class="WpfApp1.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Список товаров" Height="600" Width="1200" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок с ФИО и Выходом -->
            <RowDefinition Height="Auto"/>
            <!-- Поиск и фильтры -->
            <RowDefinition Height="*"/>
            <!-- Список товаров -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- 1. Верхняя панель -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10" Grid.Row="0">
            <TextBlock Name="lblUser" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
            <Button Content="Выход" Click="btnLogout_Click" Width="80" Height="25"/>
        </StackPanel>

        <!-- 2. Панель фильтров -->
        <StackPanel Name="pnlFilters" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed">
            <TextBlock Text="Поиск: " VerticalAlignment="Center"/>
            <TextBox Name="txtSearch" Width="200" Margin="0,0,10,0" TextChanged="txtSearch_TextChanged"/>

            <TextBlock Text="Сортировка: " VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox Name="cbSort" Width="150" Margin="0,0,10,0" SelectionChanged="cbSort_SelectionChanged">
                <ComboBoxItem Content="По цене (возр)"/>
                <ComboBoxItem Content="По цене (убыв)"/>
                <ComboBoxItem Content="По кол-ву (возр)"/>
                <ComboBoxItem Content="По кол-ву (убыв)"/>
            </ComboBox>

            <TextBlock Text="Скидка: " VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox Name="cbFilter" Width="150" SelectionChanged="cbFilter_SelectionChanged">
                <ComboBoxItem Content="Все диапазоны"/>
                <ComboBoxItem Content="0 - 12,99%"/>
                <ComboBoxItem Content="13 - 16,99%"/>
                <ComboBoxItem Content="17% и более"/>
            </ComboBox>
        </StackPanel>

        <!-- 3. Список товаров -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" >
            <ListBox Name="icProducts" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Карточка товара -->
                        <Border BorderBrush="Black" BorderThickness="1" Margin="0,0,0,10" Padding="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding QuantityInStock}" Value="0">
                                            <Setter Property="Background" Value="LightGray"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBigDiscount}" Value="True">
                                            <Setter Property="Background" Value="#23E1EF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- 1. Фото: фиксированная ширина -->
                                    <ColumnDefinition Width="150"/>
                                    <!-- 2. Текст: занимает всё оставшееся место -->
                                    <ColumnDefinition Width="1300"/>
                                    <!-- 3. Скидка: фиксированная ширина, чтобы не уезжала -->
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <!-- Левая часть: Фото -->
                                <!-- Левая часть: Фото -->
                                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" Height="120" Margin="5">
                                    <Image Source="{Binding ProductImage}" Stretch="Uniform"/>
                                </Border>

                                <!-- Центральная часть: Описание -->
                                <StackPanel Grid.Column="1" Margin="10,5,10,5">
                                    <TextBlock>
                                        <Run Text="{Binding CategoryName}" FontWeight="Bold"/>
                                        <Run Text=" | " FontWeight="Bold"/>
                                        <Run Text="{Binding ProductName}" FontWeight="Bold" FontSize="14"/>
                                    </TextBlock>

                                    <TextBlock Text="{Binding Description, StringFormat=Описание товара: {0}}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding ManufacturerName, StringFormat=Производитель: {0}}" Margin="0,2"/>
                                    <TextBlock Text="{Binding ProviderName, StringFormat=Поставщик: {0}}" Margin="0,2"/>

                                    <!-- Блок цены -->
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Цена: " />
                                        <TextBlock Text="{Binding OldPrice, StringFormat=\{0:C\}}" TextDecorations="Strikethrough" Foreground="Red" Margin="0,0,5,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding FinalPrice, StringFormat=\{0:C\}}" Foreground="Black" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding MeasureName, StringFormat=Единица измерения: {0}}" Margin="0,2"/>
                                    <TextBlock Text="{Binding QuantityInStock, StringFormat=Количество на складе: {0}}" Margin="0,2"/>
                                </StackPanel>

                                <!-- Правая часть: Действующая скидка -->
                                <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1" Margin="5" Padding="5">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Действующая" HorizontalAlignment="Center" FontSize="10"/>
                                        <TextBlock Text="скидка" HorizontalAlignment="Center" FontSize="10" Margin="0,0,0,5"/>

                                        <!-- Выводим процент -->
                                        <TextBlock Text="{Binding CurrentDiscount, StringFormat=\{0\}%}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <!-- 4. Кнопки внизу -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Name="btnAdd" Content="Добавить товар" Width="120" Height="30" Margin="0,0,10,0" Click="btnAdd_Click" Visibility="Collapsed"/>
            <Button Name="btnDelete" Content="Удалить товар" Width="120" Height="30" Margin="0,0,10,0" Click="btnDelete_Click" Visibility="Collapsed"/>
            <Button Name="btnOrders" Content="Заказы" Width="120" Height="30" Click="btnOrders_Click" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
