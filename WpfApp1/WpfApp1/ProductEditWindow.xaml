<Window x:Class="WpfApp1.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Редактирование товара" Height="550" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Артикул:" Grid.Row="0" Margin="0,0,0,5"/>
        <TextBox Name="txtArticle" Grid.Row="1" Margin="0,0,0,10"/>

        <TextBlock Text="Наименование:" Grid.Row="2" Margin="0,0,0,5"/>
        <TextBox Name="txtName" Grid.Row="3" Margin="0,0,0,10"/>

        <TextBlock Text="Цена (не может быть &lt; 0):" Grid.Row="4" Margin="0,0,0,5"/>
        <TextBox Name="txtPrice" Grid.Row="5" Margin="0,0,0,10"/>

        <TextBlock Text="Количество на складе:" Grid.Row="6" Margin="0,0,0,5"/>
        <TextBox Name="txtQty" Grid.Row="7" Margin="0,0,0,10"/>

        <TextBlock Text="Скидка (%):" Grid.Row="8" Margin="0,0,0,5"/>
        <TextBox Name="txtDiscount" Grid.Row="9" Margin="0,0,0,10"/>

        <TextBlock Text="Фото (300x200):" Grid.Row="10" Margin="0,0,0,5"/>
        <StackPanel Grid.Row="11" Orientation="Horizontal">
            <Image Name="imgPhoto" Width="100" Height="80" Stretch="Uniform" Margin="0,0,10,0"/>
            <Button Content="Загрузить фото" Click="btnLoadPhoto_Click" Height="25"/>
        </StackPanel>

        <Button Content="Сохранить" Grid.Row="12" Height="30" Margin="0,20,0,0" Click="btnSave_Click"/>
    </Grid>
</Window>
