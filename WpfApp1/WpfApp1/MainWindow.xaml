<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="ООО ЧитайГород - Вход" Height="300" Width="400">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Логин:" Margin="0,0,0,5"/>
            <TextBox Name="txtLogin" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,5"/>
            <PasswordBox Name="txtPassword" Height="25" Margin="0,0,0,20"/>

            <Button Name="btnLogin" Content="Войти" Height="30" Click="btnLogin_Click" Margin="0,0,0,10"/>
            <Button Name="btnGuest" Content="Войти как гость" Height="30" Click="btnGuest_Click"/>

            <TextBlock Name="lblError" Foreground="Red" Margin="0,10,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
